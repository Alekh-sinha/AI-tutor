{
 "id": "lesson-4",
 "title": "द्रव्यमान, आयतन और पदार्थ",
 "language": "hi-IN",
 "duration": 210.66,
 "audio": "/audio/lesson-4.mp3",
 "narration": [
  {
   "start": 0.0,
   "end": 2.92,
   "text": "हाट में जब आप कागज़ का एक खाली कप लेते हैं..."
  },
  {
   "start": 3.42,
   "end": 6.58,
   "text": "एक कप में पानी भरिए और दूसरे में सूखी बालू।"
  },
  {
   "start": 7.08,
   "end": 11.0,
   "text": "उठाने पर बालू वाला कप हाथ में ज्यादा भारी महसूस होता है।"
  },
  {
   "start": 11.5,
   "end": 15.58,
   "text": "दोनों कपों का साइज़ एक ही है, फिर भी बालू वाला कप भारी क्यों है?"
  },
  {
   "start": 16.38,
   "end": 19.58,
   "text": "जब हम दोनों कपों को तराज़ू पर रखकर तौलते हैं..."
  },
  {
   "start": 20.08,
   "end": 24.68,
   "text": "किसी वस्तु के भारी या हल्के होने के गुण को विज्ञान में द्रव्यमान (Mass) कहते हैं।"
  },
  {
   "start": 25.18,
   "end": 30.18,
   "text": "द्रव्यमान का SI मात्रक किलोग्राम (kg) है और छोटा मात्रक ग्राम (g) है।"
  },
  {
   "start": 30.68,
   "end": 35.72,
   "text": "किसी वस्तु के भारी या हल्के होने के गुण को क्या कहते हैं और इसका SI मात्रक क्या है?"
  },
  {
   "start": 36.72,
   "end": 37.84,
   "text": "सोचिए..."
  },
  {
   "start": 43.84,
   "end": 49.52,
   "text": "उत्तर है — द्रव्यमान और किलोग्राम। भारीपन का गुण द्रव्यमान है और मात्रक किलोग्राम है।"
  },
  {
   "start": 50.02,
   "end": 53.02,
   "text": "जब आप अपना बस्ता पूरी बेंच पर रख देते हैं..."
  },
  {
   "start": 53.52,
   "end": 56.12,
   "text": "तो आपके दोस्त के बैठने की जगह नहीं बचती।"
  },
  {
   "start": 56.62,
   "end": 59.1,
   "text": "बस्ते ने बेंच की पूरी जगह घेर ली है!"
  },
  {
   "start": 59.6,
   "end": 62.32,
   "text": "अब एक लीटर की पानी की बोतल देखिए।"
  },
  {
   "start": 62.82,
   "end": 66.06,
   "text": "अगर इसका पानी आधा लीटर के लोटे में उड़ेले, तो क्या होगा?"
  },
  {
   "start": 66.86,
   "end": 70.5,
   "text": "लोटे की जगह कम है, इसलिए पानी बाहर छलक जाता है!"
  },
  {
   "start": 71.0,
   "end": 75.64,
   "text": "कोई वस्तु जितना स्थान घेरती है, उसे उस वस्तु का आयतन (Volume) कहते हैं।"
  },
  {
   "start": 76.14,
   "end": 81.78,
   "text": "आयतन का मात्रक लीटर (L), मिलीलीटर (mL) या घन मीटर (m³) होता है।"
  },
  {
   "start": 82.28,
   "end": 86.52,
   "text": "कोई वस्तु जितना स्थान या जगह घेरती है, उसे उस वस्तु का क्या कहते हैं?"
  },
  {
   "start": 87.52,
   "end": 88.8,
   "text": "सोचिए..."
  },
  {
   "start": 94.8,
   "end": 100.68,
   "text": "उत्तर है — आयतन। वस्तु द्वारा घेरी गई जगह ही उसका आयतन (Volume) कहलाती है।"
  },
  {
   "start": 101.18,
   "end": 104.14,
   "text": "एक बिना फूला खाली गुब्बारा लीजिए और उसे तौलिए।"
  },
  {
   "start": 104.64,
   "end": 107.24,
   "text": "अब मुँह से हवा भरकर गुब्बारे को फुलाइए।"
  },
  {
   "start": 107.74,
   "end": 111.9,
   "text": "फुला हुआ गुब्बारा बड़ा भी हो जाता है और तराज़ू पर थोड़ा भारी भी!"
  },
  {
   "start": 112.4,
   "end": 115.96,
   "text": "जो हवा हमें दिखाई नहीं देती, क्या वह भी 'पदार्थ' (Matter) है?"
  },
  {
   "start": 116.76,
   "end": 122.24,
   "text": "विज्ञान में हर वह चीज़ जो स्थान घेरती है और जिसमें द्रव्यमान होता है, पदार्थ है।"
  },
  {
   "start": 122.74,
   "end": 126.82,
   "text": "हवा जगह भी घेरती है और इसमें द्रव्यमान भी है, इसलिए हवा भी पदार्थ है!"
  },
  {
   "start": 127.32,
   "end": 132.68,
   "text": "वैज्ञानिक नियम के अनुसार किसी चीज़ को 'पदार्थ' कहलाने के लिए कौन सी दो शर्तें चाहिए?"
  },
  {
   "start": 133.68,
   "end": 134.76,
   "text": "सोचिए..."
  },
  {
   "start": 140.76,
   "end": 147.64,
   "text": "उत्तर है — स्थान घेरना और द्रव्यमान होना। जिस वस्तु में द्रव्यमान हो और जगह घेरे, वह पदार्थ है।"
  },
  {
   "start": 148.14,
   "end": 153.34,
   "text": "हज़ारों साल पहले भारत में आयुर्वेद के ऋषियों ने भी पदार्थों को उनके गुणों से बाँटा था।"
  },
  {
   "start": 153.84,
   "end": 158.4,
   "text": "उन्होंने जोड़ों में गुण बताए—जैसे गुरु यानी भारी और लघु यानी हल्का।"
  },
  {
   "start": 158.9,
   "end": 164.38,
   "text": "शीत यानी ठंडा और उष्ण यानी गर्म, कठिन यानी कठोर और मृदु यानी कोमल।"
  },
  {
   "start": 164.88,
   "end": 168.0,
   "text": "अब अपने आस-पास की ईंट, पानी और सुतली को देखिए।"
  },
  {
   "start": 168.5,
   "end": 173.18,
   "text": "ये सभी अलग-अलग दिखते हैं, पर सब स्थान घेरते हैं और सब में द्रव्यमान है।"
  },
  {
   "start": 173.68,
   "end": 177.96,
   "text": "हमारे आस-पास की ईंट, पानी, हवा और सुतली—क्या ये सब 'पदार्थ' (Matter) हैं?"
  },
  {
   "start": 178.96,
   "end": 179.96,
   "text": "सोचिए..."
  },
  {
   "start": 185.96,
   "end": 191.96,
   "text": "उत्तर है — हाँ, ये सभी पदार्थ हैं। क्योंकि इन सब में द्रव्यमान है और ये जगह घेरते हैं।"
  },
  {
   "start": 192.46,
   "end": 198.38,
   "text": "आज हमने जाना कि हर वस्तु जो जगह घेरती है और जिसमें द्रव्यमान होता है, वह पदार्थ है।"
  },
  {
   "start": 198.88,
   "end": 203.92,
   "text": "वस्तु द्वारा घेरी गई जगह उसका आयतन है और उसमें मौजूद सामग्री उसका द्रव्यमान है।"
  },
  {
   "start": 204.42,
   "end": 209.66,
   "text": "घर पर सींक के दोनों सिरों पर गुब्बारे बाँधकर तराज़ू बनाइए और हवा का द्रव्यमान नापिए!"
  }
 ],
