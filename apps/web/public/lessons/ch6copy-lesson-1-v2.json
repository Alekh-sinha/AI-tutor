{
 "id": "ch6copy-lesson-1-v2",
 "title": "वस्तुएँ, पदार्थ और वर्गीकरण",
 "language": "hi-IN",
 "duration": 326.36,
 "audio": "/audio/ch6copy-lesson-1-v2.mp3",
 "narration": [
  {
   "start": 0.0,
   "end": 1.28,
   "text": "नमस्ते बच्चो!"
  },
  {
   "start": 1.78,
   "end": 9.86,
   "text": "क्या आपने कभी सोचा है कि आपके हाथ में जो किताब है, जिस चौकी पर आप बैठे हैं, और जिस गिलास से आप पानी पीते हैं—ये सब चीज़ें किससे बनी हैं?"
  },
  {
   "start": 10.66,
   "end": 16.34,
   "text": "और हमारी रसोई में बर्तन, मसाले या कपड़े हमेशा अलग-अलग जगहों पर संभालकर क्यों रखे जाते हैं?"
  },
  {
   "start": 17.14,
   "end": 20.82,
   "text": "आज के इस पाठ में हम इन्हीं मज़ेदार सवालों के जवाब ढूँढेंगे!"
  },
  {
   "start": 21.32,
   "end": 29.32,
   "text": "बच्चों, अपने आस-पास देखिए। आपको बहुत सारी चीज़ें दिखाई देंगी—जैसे बोतल, चम्मच, गिलास, कुल्हड़, लकड़ी का गुटका और कॉपी।"
  },
  {
   "start": 29.82,
   "end": 35.02,
   "text": "इन सभी चीज़ों को हम वस्तुएँ कहते हैं। अब सोचिए, ये वस्तुएँ बनी किस चीज़ से हैं?"
  },
  {
   "start": 35.82,
   "end": 41.06,
   "text": "गिलास और बोतल पानी रखने के काम आती हैं, पर गिलास काँच का बना है और बोतल प्लास्टिक की।"
  },
  {
   "start": 41.56,
   "end": 45.92,
   "text": "कुल्हड़ मिट्टी से बना है, चम्मच स्टील की है, और कॉपी कागज़ से बनी है।"
  },
  {
   "start": 46.42,
   "end": 51.06,
   "text": "जिस चीज़ का उपयोग वस्तु बनाने में किया जाता है, उसे विज्ञान में पदार्थ कहते हैं।"
  },
  {
   "start": 51.56,
   "end": 56.44,
   "text": "कागज़, लकड़ी, कपड़ा, काँच, धातु, प्लास्टिक और मिट्टी—ये सब पदार्थ के उदाहरण हैं।"
  },
  {
   "start": 56.94,
   "end": 62.42,
   "text": "कोई वस्तु केवल एक ही पदार्थ से बन सकती है, या एक से अधिक पदार्थों से मिलकर भी बन सकती है।"
  },
  {
   "start": 62.92,
   "end": 70.08,
   "text": "इस पेन को देखिए। इसका बाहरी ढाँचा प्लास्टिक का बना है, क्लिप धातु की है, और इसके अंदर रिफिल में स्याही भरी है।"
  },
  {
   "start": 70.58,
   "end": 74.54,
   "text": "यानी एक अकेली वस्तु पेन को बनाने में कई पदार्थों का इस्तेमाल हुआ है।"
  },
  {
   "start": 75.04,
   "end": 79.08,
   "text": "इसी तरह, एक ही पदार्थ से कई अलग-अलग वस्तुएँ बनाई जा सकती हैं।"
  },
  {
   "start": 79.58,
   "end": 86.94,
   "text": "इस चित्र में देखिए—लकड़ी एक पदार्थ है, लेकिन इससे छोटी कुर्सी, चम्मच, पेंसिल और खेलने वाला गुटका, सब बनाए गए हैं!"
  },
  {
   "start": 87.44,
   "end": 92.48,
   "text": "वस्तु वह चीज़ है जिसका हम उपयोग करते हैं, और पदार्थ वह सामग्री है जिससे वह बनी है।"
  },
  {
   "start": 92.98,
   "end": 98.58,
   "text": "चित्र में मेज पर रखी वस्तुओं—प्लास्टिक की बोतल, चम्मच और गिलास में 'पदार्थ' कौन-कौन से हैं?"
  },
  {
   "start": 99.58,
   "end": 101.74,
   "text": "सोचिए और सही उत्तर चुनिए..."
  },
  {
   "start": 107.74,
   "end": 109.98,
   "text": "उत्तर है — प्लास्टिक, धातु और काँच।"
  },
  {
   "start": 110.48,
   "end": 116.56,
   "text": "बोतल, चम्मच और गिलास वस्तुएँ हैं, जबकि प्लास्टिक, धातु और काँच वे पदार्थ हैं जिनसे ये वस्तुएँ बनी हैं।"
  },
  {
   "start": 117.06,
   "end": 123.38,
   "text": "रसोई में बर्तन और डिब्बे सलीके से अलग रखे होते हैं, और दुकानों में दवाइयों को संभालकर रखा जाता है।"
  },
  {
   "start": 123.88,
   "end": 128.44,
   "text": "वस्तुओं को उनके समान गुणों के आधार पर समूहों में रखने को वर्गीकरण कहते हैं।"
  },
  {
   "start": 128.94,
   "end": 132.94,
   "text": "जैसे आकार, रंग, कठोरता या नरम होना, या वे किस पदार्थ से बनी हैं।"
  },
  {
   "start": 133.44,
   "end": 137.0,
   "text": "वर्गीकरण से चीज़ों को ढूँढना और समझना आसान हो जाता है।"
  },
  {
   "start": 137.5,
   "end": 142.42,
   "text": "वर्गीकरण का असली आधार वस्तुओं के समान गुण होते हैं, केवल सजाकर रखना नहीं।"
  },
  {
   "start": 142.92,
   "end": 150.2,
   "text": "रसोई के बर्तनों—स्टील की थालियों, मिट्टी के बर्तनों और काँच के डिब्बों—को समूहों में बाँटने का सबसे सही आधार क्या होगा?"
  },
  {
   "start": 151.2,
   "end": 152.16,
   "text": "सोचिए..."
  },
  {
   "start": 158.16,
   "end": 160.92,
   "text": "उत्तर है — वे जिस पदार्थ से बने हैं।"
  },
  {
   "start": 161.42,
   "end": 166.7,
   "text": "यहाँ बर्तनों को उनके पदार्थ के गुण के आधार पर तीन समूहों में वर्गीकृत किया जा सकता है।"
  },
  {
   "start": 167.2,
   "end": 170.4,
   "text": "सोचिए, क्या हम कपड़े या कागज़ का गिलास बना सकते हैं?"
  },
  {
   "start": 171.2,
   "end": 176.72,
   "text": "इस चित्र में देखिए, जैसे ही कपड़े की पोटली में पानी डाला जाता है, पानी रिसकर नीचे गिर जाता है।"
  },
  {
   "start": 177.22,
   "end": 181.98,
   "text": "इसी तरह कागज़ का गिलास भी पानी भरने पर गल जाता है और पानी नहीं रोक पाता।"
  },
  {
   "start": 182.48,
   "end": 186.28,
   "text": "द्रव रखने के लिए काँच, प्लास्टिक या धातु जैसे पदार्थ ही चाहिए।"
  },
  {
   "start": 186.78,
   "end": 190.1,
   "text": "इसी तरह, क्या हम कागज़ की कड़ाही में खाना पका सकते हैं?"
  },
  {
   "start": 190.9,
   "end": 193.34,
   "text": "नहीं, क्योंकि आग पर कागज़ जल जाएगा!"
  },
  {
   "start": 193.84,
   "end": 198.36,
   "text": "खाना पकाने के लिए ऐसा पदार्थ चाहिए जो आग की गर्मी सह सके, जैसे धातु।"
  },
  {
   "start": 198.86,
   "end": 204.26,
   "text": "किसी भी वस्तु को बनाने के लिए पदार्थ का चुनाव उसके गुणों और उपयोग पर निर्भर करता है।"
  },
  {
   "start": 204.76,
   "end": 209.76,
   "text": "कोई भी पदार्थ किसी भी वस्तु को बनाने के काम नहीं आ सकता, गुण काम से मेल खाने चाहिए।"
  },
  {
   "start": 210.26,
   "end": 215.9,
   "text": "पानी या द्रव रखने के लिए धातु के बर्तन का उपयोग क्यों किया जाता है, कपड़े की थैली का क्यों नहीं?"
  },
  {
   "start": 216.9,
   "end": 218.54,
   "text": "सोचिए और उत्तर चुनिए..."
  },
  {
   "start": 224.54,
   "end": 229.5,
   "text": "उत्तर है — क्योंकि धातु पानी को रोक कर रखती है, जबकि कपड़े से पानी रिस जाता है।"
  },
  {
   "start": 230.0,
   "end": 235.32,
   "text": "कपड़ा छिद्रदार होने से पानी नहीं रोक पाता, जबकि धातु द्रव को सुरक्षित रोकती है।"
  },
  {
   "start": 235.82,
   "end": 238.02,
   "text": "इस चित्र में तीन गेंदें रखी हैं।"
  },
  {
   "start": 238.52,
   "end": 245.16,
   "text": "चमड़े की सख्त गेंद क्रिकेट के लिए, टेनिस गेंद टप्पा खाने के लिए, और नरम रबर की गेंद कसरत के लिए है।"
  },
  {
   "start": 245.66,
   "end": 251.7,
   "text": "यदि इन तीनों गेंदों को एक ही ऊँचाई से गिराया जाए, तो वे अपने पदार्थ के अनुसार अलग-अलग स्तर तक उछलेंगी।"
  },
  {
   "start": 252.2,
   "end": 257.88,
   "text": "क्रिकेट के लिए सख्त गेंद चाहिए, जबकि कसरत के लिए ऐसी गेंद चाहिए जिसे आसानी से दबाया जा सके।"
  },
  {
   "start": 258.38,
   "end": 264.22,
   "text": "अलग-अलग ज़रूरतों को पूरा करने के लिए एक ही जैसी वस्तुओं को अलग-अलग पदार्थों से बनाया जाता है।"
  },
  {
   "start": 264.72,
   "end": 270.04,
   "text": "सभी गेंदें एक समान नहीं होतीं, देखने में गोल होने के बावजूद उनके गुण अलग होते हैं।"
  },
  {
   "start": 270.54,
   "end": 274.7,
   "text": "व्यायाम करने वाली नरम गेंद को चमड़े या लकड़ी से क्यों नहीं बनाया जाता?"
  },
  {
   "start": 275.7,
   "end": 276.7,
   "text": "सोचिए..."
  },
  {
   "start": 282.7,
   "end": 286.86,
   "text": "उत्तर है — क्योंकि चमड़ा और लकड़ी दबाने पर आसानी से नहीं दबते।"
  },
  {
   "start": 287.36,
   "end": 292.76,
   "text": "कसरत के लिए गेंद का नरम और दबने योग्य होना ज़रूरी है, जो गुण केवल नरम रबर में होता है।"
  },
  {
   "start": 293.26,
   "end": 296.18,
   "text": "आइए आज सीखे गए मुख्य बिंदुओं को दोहरा लें।"
  },
  {
   "start": 296.68,
   "end": 302.32,
   "text": "पहला, हमारे आस-पास की चीज़ें वस्तुएँ हैं, और जिन सामग्रियों से वे बनती हैं उन्हें पदार्थ कहते हैं।"
  },
  {
   "start": 302.82,
   "end": 308.02,
   "text": "दूसरा, वस्तुओं को उनके समान गुणों के आधार पर समूहों में बाँटना वर्गीकरण कहलाता है।"
  },
  {
   "start": 308.52,
   "end": 314.84,
   "text": "तीसरा, किसी वस्तु को बनाने के लिए पदार्थ का चुनाव उस वस्तु के काम और पदार्थ के गुणों पर निर्भर करता है।"
  },
  {
   "start": 315.34,
   "end": 320.42,
   "text": "चौथा, एक ही जैसी वस्तु को अलग-अलग कार्यों के लिए अलग-अलग पदार्थों से बनाया जाता है।"
  },
  {
   "start": 320.92,
   "end": 325.36,
   "text": "अब आपके लिए एक मज़ेदार गृह-कार्य है, जिसे आप अपने घर की चीज़ों से कर सकते हैं!"
  }
 ],
