{
 "id": "ch9-lesson-2-v2",
 "title": "धातुओं की रासायनिक अभिक्रियाएँ: ऑक्सीजन और जल के साथ",
 "language": "hi-IN",
 "duration": 537.14,
 "audio": "/audio/ch9-lesson-2-v2.mp3",
 "narration": [
  {
   "start": 0.0,
   "end": 5.8,
   "text": "नमस्ते बच्चो! क्या आपने कभी सोचा है कि तांबे का बर्तन पुराना होने पर काला क्यों पड़ जाता है?"
  },
  {
   "start": 6.6,
   "end": 9.56,
   "text": "या फिर लोहे के दरवाजे पर जंग क्यों लग जाती है?"
  },
  {
   "start": 10.36,
   "end": 15.68,
   "text": "आज हम सीखेंगे कि धातुएँ हवा की ऑक्सीजन और पानी से अभिक्रिया करके कैसे बदल जाती हैं!"
  },
  {
   "start": 16.18,
   "end": 19.62,
   "text": "2Cu + O2 → 2CuO"
  },
  {
   "start": 20.12,
   "end": 24.84,
   "text": "बच्चों, तांबे के लाल-भूरे तार को जब हम आग पर गर्म करते हैं, तो ध्यान से देखिए:"
  },
  {
   "start": 25.34,
   "end": 30.26,
   "text": "धातु (Metal) + ऑक्सीजन (Oxygen) → धातु ऑक्साइड (Metal oxide)"
  },
  {
   "start": 30.76,
   "end": 36.88,
   "text": "तांबे पर एक काली परत चढ़ जाती है। यह काला पदार्थ कॉपर(II) ऑक्साइड (CuO) है।"
  },
  {
   "start": 37.38,
   "end": 42.06,
   "text": "4Al + 3O2 → 2Al2O3"
  },
  {
   "start": 42.56,
   "end": 51.04,
   "text": "यहाँ तांबा हवा की ऑक्सीजन से जुड़कर ऑक्साइड बनाता है। इसे सामान्य समीकरण में ऐसे लिखते हैं: धातु + ऑक्सीजन → धातु ऑक्साइड।"
  },
  {
   "start": 51.54,
   "end": 59.14,
   "text": "इसी तरह, एल्युमीनियम भी एल्युमीनियम ऑक्साइड बनाता है: 4Al + 3O₂ → 2Al₂O₃।"
  },
  {
   "start": 59.64,
   "end": 69.52,
   "text": "अधिकांश धातुओं के ऑक्साइड क्षारीय प्रकृति के होते हैं। इसके विपरीत, अधातुएँ जैसे सल्फर, ऑक्सीजन के साथ अभिक्रिया करके अम्लीय ऑक्साइड बनाती हैं।"
  },
  {
   "start": 70.02,
   "end": 76.3,
   "text": "ध्यान रखें, तांबा स्वयं नहीं जलता, केवल उसकी सतह पर ऑक्सीजन जुड़ने से काले रंग की कॉपर ऑक्साइड की परत बनती है।"
  },
  {
   "start": 76.8,
   "end": 83.0,
   "text": "चित्र में दिखाए गए काले कॉपर ऑक्साइड की प्रकृति कैसी होती है? (A) अम्लीय (B) क्षारीय (C) इनमें से कोई नहीं।"
  },
  {
   "start": 84.0,
   "end": 84.96,
   "text": "सोचिए..."
  },
  {
   "start": 90.96,
   "end": 99.8,
   "text": "उत्तर है — (B) क्षारीय। कॉपर ऑक्साइड एक धातु ऑक्साइड है और अधिकांश धातु ऑक्साइडों की तरह यह क्षारीय प्रकृति का होता है।"
  },
  {
   "start": 100.3,
   "end": 108.26,
   "text": "यदि हम एल्युमीनियम ऑक्साइड के सफेद पाउडर को एक परखनली में लेकर उसमें थोड़ा अम्ल मिलाएँ, तो वह अभिक्रिया करके घुल जाता है।"
  },
  {
   "start": 108.76,
   "end": 113.64,
   "text": "और यदि इसी सफेद पाउडर में क्षार मिलाएँ, तो यह क्षार में भी घुलकर अभिक्रिया कर लेता है!"
  },
  {
   "start": 114.14,
   "end": 124.06,
   "text": "जो धातु ऑक्साइड अम्ल और क्षार दोनों से अभिक्रिया करके लवण और जल बनाते हैं, उन्हें उभयधर्मी ऑक्साइड कहते हैं, जैसे एल्युमीनियम ऑक्साइड और जिंक ऑक्साइड।"
  },
  {
   "start": 124.56,
   "end": 132.84,
   "text": "आइए इसके समीकरण देखें। Hydrochloric acid के साथ: Al₂O₃ + 6HCl → 2AlCl₃ + 3H₂O।"
  },
  {
   "start": 133.34,
   "end": 143.94,
   "text": "Sodium hydroxide (क्षार) के साथ: Al₂O₃ + 2NaOH → 2NaAlO₂ + H₂O। यहाँ सोडियम एल्युमिनेट और जल बनता है।"
  },
  {
   "start": 144.44,
   "end": 147.24,
   "text": "अधिकांश धातु ऑक्साइड पानी में नहीं घुलते।"
  },
  {
   "start": 147.74,
   "end": 155.46,
   "text": "लेकिन सोडियम ऑक्साइड और पोटेशियम ऑक्साइड पानी में घुलकर क्षार बनाते हैं, जिन्हें ऐल्कली कहते हैं, जैसे NaOH और KOH।"
  },
  {
   "start": 155.96,
   "end": 163.32,
   "text": "इनमें से कौन-सा उभयधर्मी ऑक्साइड का उदाहरण है? (A) CuO (B) Al₂O₃ (C) Na₂O।"
  },
  {
   "start": 164.32,
   "end": 165.32,
   "text": "सोचिए..."
  },
  {
   "start": 171.32,
   "end": 181.4,
   "text": "उत्तर है — (B) Al₂O₃। एल्युमीनियम ऑक्साइड अम्ल और क्षार दोनों के साथ अभिक्रिया करके लवण और जल बनाता है, इसलिए यह उभयधर्मी ऑक्साइड है।"
  },
  {
   "start": 181.9,
   "end": 185.86,
   "text": "सभी धातुएँ एक समान तेज़ी से ऑक्सीजन से क्रिया नहीं करतीं।"
  },
  {
   "start": 186.36,
   "end": 191.44,
   "text": "सोडियम और पोटेशियम खुले में रखने पर हवा की ऑक्सीजन से क्रिया करके तुरंत आग पकड़ लेते हैं!"
  },
  {
   "start": 191.94,
   "end": 196.22,
   "text": "इसीलिए इन्हें हमेशा केरोसिन (मिट्टी के तेल) में डुबोकर रखा जाता है।"
  },
  {
   "start": 196.72,
   "end": 203.36,
   "text": "मैग्नीशियम, एल्युमीनियम, जिंक और लेड की सतह पर सामान्य तापमान पर ऑक्साइड की पतली, सुरक्षात्मक परत बन जाती है।"
  },
  {
   "start": 203.86,
   "end": 207.9,
   "text": "यह परत अंदर की धातु को आगे ऑक्सीजन से क्रिया करने से रोकती है।"
  },
  {
   "start": 208.4,
   "end": 214.32,
   "text": "लोहे का बड़ा टुकड़ा गर्म करने पर नहीं जलता, लेकिन लोहे का चूर्ण ज्वाला में छिड़कने पर तेज़ी से जलता है।"
  },
  {
   "start": 214.82,
   "end": 218.86,
   "text": "तांबा जलता नहीं, पर उस पर काले कॉपर ऑक्साइड की परत चढ़ जाती है।"
  },
  {
   "start": 219.36,
   "end": 223.44,
   "text": "सोना और चांदी उच्च तापमान पर भी ऑक्सीजन से क्रिया नहीं करते।"
  },
  {
   "start": 223.94,
   "end": 233.94,
   "text": "एल्युमीनियम की वस्तुओं पर तनु सल्फ्यूरिक अम्ल का उपयोग करके मोटी एल्युमीनियम ऑक्साइड की सुरक्षात्मक परत चढ़ाई जाती है। इस प्रक्रिया को एनोडीकरण कहते हैं।"
  },
  {
   "start": 234.44,
   "end": 239.24,
   "text": "सोडियम और पोटेशियम को मिट्टी के तेल (केरोसिन) में क्यों डुबोकर रखा जाता है?"
  },
  {
   "start": 240.04,
   "end": 247.48,
   "text": "(A) ताकि वे पिघल न जाएँ (B) ताकि वे हवा की ऑक्सीजन से क्रिया करके आग न पकड़ लें (C) ताकि उनका रंग न बदले।"
  },
  {
   "start": 248.48,
   "end": 249.48,
   "text": "सोचिए..."
  },
  {
   "start": 255.48,
   "end": 260.2,
   "text": "उत्तर है — (B) ताकि वे हवा की ऑक्सीजन से क्रिया करके आग न पकड़ लें।"
  },
  {
   "start": 260.7,
   "end": 264.22,
   "text": "सोडियम और पोटेशियम हवा में बहुत तेज़ी से जलने लगते हैं।"
  },
  {
   "start": 264.72,
   "end": 271.92,
   "text": "जब हम सोडियम या पोटेशियम के टुकड़े को पानी में डालते हैं, तो बहुत तीव्र अभिक्रिया होती है और हाइड्रोजन गैस निकलती है।"
  },
  {
   "start": 272.42,
   "end": 282.46,
   "text": "इस अवलोकन से सामान्य समीकरण बनता है: धातु + जल → धातु ऑक्साइड + हाइड्रोजन गैस। यदि धातु ऑक्साइड घुलनशील है, तो धातु हाइड्रॉक्साइड बनता है।"
  },
  {
   "start": 282.96,
   "end": 289.84,
   "text": "सोडियम और पोटेशियम ठंडे पानी से हिंसक अभिक्रिया करते हैं, जिससे निकलने वाली हाइड्रोजन गैस तुरंत आग पकड़ लेती है!"
  },
  {
   "start": 290.34,
   "end": 299.38,
   "text": "कैल्शियम ठंडे पानी से धीमी क्रिया करता है। बने हुए हाइड्रोजन गैस के बुलबुले सतह पर चिपक जाते हैं, जिससे कैल्शियम पानी पर तैरने लगता है।"
  },
  {
   "start": 299.88,
   "end": 307.08,
   "text": "मैग्नीशियम ठंडे पानी से क्रिया नहीं करता, यह केवल गर्म पानी से अभिक्रिया करके मैग्नीशियम हाइड्रॉक्साइड और हाइड्रोजन गैस बनाता है।"
  },
  {
   "start": 307.58,
   "end": 312.7,
   "text": "एल्युमीनियम, लोहा और जिंक केवल भाप से क्रिया करके ऑक्साइड और हाइड्रोजन बनाते हैं।"
  },
  {
   "start": 313.2,
   "end": 318.24,
   "text": "लेड, कॉपर, सिल्वर और गोल्ड जल के किसी भी रूप (ठंडा, गर्म या भाप) से क्रिया नहीं करते।"
  },
  {
   "start": 318.74,
   "end": 325.54,
   "text": "इनमें से कौन-सी धातु ठंडे जल के साथ इतनी तीव्र अभिक्रिया करती है कि निकलने वाली हाइड्रोजन गैस आग पकड़ लेती है?"
  },
  {
   "start": 326.34,
   "end": 331.94,
   "text": "(A) पोटेशियम (K) (B) मैग्नीशियम (Mg) (C) लोहा (Fe)।"
  },
  {
   "start": 332.94,
   "end": 334.42,
   "text": "सोचिए..."
  },
  {
   "start": 340.42,
   "end": 349.14,
   "text": "उत्तर है — (A) पोटेशियम। पोटेशियम ठंडे पानी के साथ बहुत हिंसक अभिक्रिया करता है और अत्यधिक ऊष्मा से हाइड्रोजन गैस तुरंत जलने लगती है।"
  },
  {
   "start": 349.64,
   "end": 351.52,
   "text": "आइए इसके समीकरण देखें:"
  },
  {
   "start": 352.02,
   "end": 358.14,
   "text": "Al2O3 + 6HCl → 2AlCl3 + 3H2O"
  },
  {
   "start": 358.64,
   "end": 367.92,
   "text": "Al2O3 + 2NaOH → 2NaAlO2 + H2O"
  },
  {
   "start": 368.42,
   "end": 373.5,
   "text": "यहाँ सोडियम एल्युमिनेट (NaAlO2) और जल बनता है।"
  },
  {
   "start": 374.0,
   "end": 376.24,
   "text": "आइए आज जो सीखा उसे दोहरा लें।"
  },
  {
   "start": 376.74,
   "end": 384.34,
   "text": "एल्युमीनियम ऑक्साइड और जिंक ऑक्साइड उभयधर्मी ऑक्साइड हैं, जो अम्ल और क्षार दोनों से क्रिया करके लवण और जल बनाते हैं।"
  },
  {
   "start": 384.84,
   "end": 392.0,
   "text": "हम क्या सीखेंगे: अलग-अलग धातुएँ ऑक्सीजन के साथ कितनी तेज़ी से क्रिया करती हैं और एनोडीकरण (Anodising) क्या है।"
  },
  {
   "start": 392.5,
   "end": 396.26,
   "text": "सभी धातुएँ एक समान तेज़ी से ऑक्सीजन से क्रिया नहीं करतीं:"
  },
  {
   "start": 396.76,
   "end": 401.8,
   "text": "इसीलिए इन्हें सुरक्षित रखने के लिए हमेशा केरोसिन (मिट्टी के तेल) में डुबोकर रखा जाता है।"
  },
  {
   "start": 402.3,
   "end": 406.42,
   "text": "यह परत अंदर की धातु को आगे ऑक्सीजन से क्रिया करने से रोकती है।"
  },
  {
   "start": 406.92,
   "end": 414.68,
   "text": "लोहा और तांबा: लोहे का बड़ा टुकड़ा गर्म करने पर नहीं जलता, लेकिन लोहे का चूर्ण (Iron filings) ज्वाला में छिड़कने पर तेज़ी से जलता है।"
  },
  {
   "start": 415.18,
   "end": 419.42,
   "text": "तांबा जलता नहीं है, पर उस पर काले कॉपर ऑक्साइड की परत चढ़ जाती है।"
  },
  {
   "start": 419.92,
   "end": 424.56,
   "text": "सोना और चांदी: ये उच्च तापमान पर भी ऑक्सीजन से क्रिया नहीं करते।"
  },
  {
   "start": 425.06,
   "end": 433.02,
   "text": "एल्युमीनियम की वस्तुओं पर तनु सल्फ्यूरिक अम्ल (dilute sulphuric acid) का उपयोग करके एक मोटी एल्युमीनियम ऑक्साइड की सुरक्षात्मक परत चढ़ाई जाती है।"
  },
  {
   "start": 433.52,
   "end": 443.04,
   "text": "स्पष्टीकरण: सोडियम और पोटेशियम हवा में बहुत तेज़ी से ऑक्सीजन के साथ अभिक्रिया करके जलने लगते हैं, इसलिए उन्हें हवा की ऑक्सीजन से अलग रखने के लिए केरोसिन में रखा जाता है।"
  },
  {
   "start": 443.54,
   "end": 450.22,
   "text": "जब हम सोडियम या पोटेशियम के टुकड़े को पानी में डालते हैं, तो बहुत तीव्र अभिक्रिया होती है और हाइड्रोजन गैस निकलती है।"
  },
  {
   "start": 450.72,
   "end": 454.96,
   "text": "सोडियम और पोटेशियम अत्यधिक सक्रिय हैं जिन्हें केरोसिन में रखा जाता है।"
  },
  {
   "start": 455.46,
   "end": 461.38,
   "text": "मैग्नीशियम, एल्युमीनियम पर सुरक्षात्मक परत बनती है और एनोडीकरण इस परत को मोटा बनाता है।"
  },
  {
   "start": 461.88,
   "end": 465.24,
   "text": "धातु + जल → धातु ऑक्साइड + हाइड्रोजन गैस"
  },
  {
   "start": 465.74,
   "end": 471.1,
   "text": "यदि धातु ऑक्साइड जल में घुलनशील है, तो वह धातु हाइड्रॉक्साइड (Metal hydroxide) बना लेता है।"
  },
  {
   "start": 471.6,
   "end": 479.44,
   "text": "ठंडे जल के साथ: सोडियम और पोटेशियम ठंडे पानी से हिंसक अभिक्रिया करते हैं, जिससे पैदा होने वाली हाइड्रोजन गैस तुरंत आग पकड़ लेती है।"
  },
  {
   "start": 479.94,
   "end": 485.78,
   "text": "बने हुए हाइड्रोजन गैस के बुलबुले धातु की सतह से चिपक जाते हैं, जिससे कैल्शियम पानी पर तैरने लगता है।"
  },
  {
   "start": 486.28,
   "end": 493.48,
   "text": "जल के साथ कोई अभिक्रिया नहीं: लेड, कॉपर, सिल्वर और गोल्ड जल के किसी भी रूप (ठंडा, गर्म या भाप) से क्रिया नहीं करते।"
  },
  {
   "start": 493.98,
   "end": 502.54,
   "text": "स्पष्टीकरण: पोटेशियम ठंडे पानी के साथ बहुत हिंसक अभिक्रिया करता है और अत्यधिक ऊष्मा उत्पन्न होने से हाइड्रोजन गैस तुरंत जलने लगती है।"
  },
  {
   "start": 503.04,
   "end": 507.84,
   "text": "ऑक्सीजन से क्रिया: धातु + ऑक्सीजन → धातु ऑक्साइड (सामान्यतः क्षारीय)।"
  },
  {
   "start": 508.34,
   "end": 516.26,
   "text": "उभयधर्मी ऑक्साइड: Al2O3 और ZnO जैसे ऑक्साइड अम्ल और क्षार दोनों से क्रिया करके लवण और जल बनाते हैं।"
  },
  {
   "start": 516.76,
   "end": 527.6,
   "text": "जल से क्रिया: Na और K ठंडे पानी में आग पकड़ते हैं, Ca तैरता है, Mg गर्म पानी से, Al, Fe, Zn भाप से, और Cu, Ag, Au कोई क्रिया नहीं करते।"
  },
  {
   "start": 528.1,
   "end": 536.14,
   "text": "अब समय है आज की गृह-गतिविधि का! घर पर एल्युमीनियम के बर्तन की धुंधली परत को रगड़कर देखिए और अपना अवलोकन रिकॉर्ड कीजिए।"
  }
 ],
