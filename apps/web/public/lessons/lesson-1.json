{
 "id": "lesson-1",
 "title": "वस्तुएँ, पदार्थ और वर्गीकरण",
 "language": "hi-IN",
 "duration": 170.02,
 "audio": "/audio/lesson-1.mp3",
 "narration": [
  {
   "start": 0.0,
   "end": 4.12,
   "text": "सोचो, सुबह चाय पीने के लिए दादाजी मिट्टी के कुल्हड़ का उपयोग करते हैं।"
  },
  {
   "start": 4.62,
   "end": 7.66,
   "text": "माँ रसोई में स्टील के गिलास में चाय देती हैं।"
  },
  {
   "start": 8.16,
   "end": 11.32,
   "text": "और दुकान पर वही चाय कागज़ के कप में मिलती है।"
  },
  {
   "start": 11.82,
   "end": 15.38,
   "text": "इन तीनों अलग-अलग बर्तनों में गर्म चाय ही भरी जाती है।"
  },
  {
   "start": 15.88,
   "end": 19.24,
   "text": "ध्यान से देखिए, तीन अलग बर्तन हैं पर काम एक ही है!"
  },
  {
   "start": 19.74,
   "end": 23.7,
   "text": "और मिट्टी, स्टील तथा कागज़ पदार्थ (material) हैं जिनसे ये बने हैं।"
  },
  {
   "start": 24.2,
   "end": 27.84,
   "text": "एक ही पदार्थ से कई अलग-अलग वस्तुएँ बनाई जा सकती हैं।"
  },
  {
   "start": 28.34,
   "end": 32.18,
   "text": "तुम्हारे हाथ में जो पेंसिल है, क्या वह केवल एक ही पदार्थ से बनी है?"
  },
  {
   "start": 33.18,
   "end": 34.46,
   "text": "सोचिए..."
  },
  {
   "start": 40.46,
   "end": 44.78,
   "text": "उत्तर है — नहीं, पेंसिल लकड़ी, ग्रेफाइट और रबड़ से मिलकर बनती है।"
  },
  {
   "start": 45.28,
   "end": 49.28,
   "text": "गर्मी के दिनों में अगर तुम सूती कपड़े का थैला बनाकर पानी भरोगे..."
  },
  {
   "start": 49.78,
   "end": 52.78,
   "text": "पूरा पानी कपड़े के छोटे-छोटे छिद्रों से टपक जाएगा!"
  },
  {
   "start": 53.28,
   "end": 56.92,
   "text": "पर वही पानी जब तांबे की बोतल में रखते हैं, तो रुका रहता है।"
  },
  {
   "start": 57.42,
   "end": 60.1,
   "text": "और काँच के गिलास में भी पानी भरा रहता है।"
  },
  {
   "start": 60.6,
   "end": 64.32,
   "text": "हम पानी रखने का बर्तन सूती कपड़े या कागज़ का क्यों नहीं बनाते?"
  },
  {
   "start": 65.12,
   "end": 69.84,
   "text": "हम वस्तु बनाने के लिए सही पदार्थ उसके गुणों और उपयोग के हिसाब से चुनते हैं।"
  },
  {
   "start": 70.34,
   "end": 75.14,
   "text": "जैसे खाना पकाने के लिए हम लोहे की कढ़ाई चुनते हैं, क्योंकि लोहा आग सहता है।"
  },
  {
   "start": 75.64,
   "end": 78.6,
   "text": "क्रिकेट खेलने के लिए सख्त लेदर की गेंद ली जाती है।"
  },
  {
   "start": 79.1,
   "end": 82.86,
   "text": "और टेनिस खेलने के लिए स्पंजी रबड़ की गेंद का उपयोग होता है।"
  },
  {
   "start": 83.36,
   "end": 87.64,
   "text": "क्या हम पूरी तरह कागज़ से बनी कढ़ाई में चूल्हे पर सब्जी बना सकते हैं?"
  },
  {
   "start": 88.64,
   "end": 89.6,
   "text": "सोचिए..."
  },
  {
   "start": 95.6,
   "end": 99.84,
   "text": "उत्तर है — नहीं, क्योंकि कागज़ आग की गर्मी से तुरंत जल जाएगा।"
  },
  {
   "start": 100.34,
   "end": 103.62,
   "text": "रमेश गाँव के हाट की दुकान पर साबुन खरीदने गया।"
  },
  {
   "start": 104.12,
   "end": 107.4,
   "text": "क्योंकि उसने मसालों को काँच के डिब्बों में अलग रखा था।"
  },
  {
   "start": 107.9,
   "end": 111.06,
   "text": "और दाल-अनाज को अलग-अलग जुट के बोरों में रखा था।"
  },
  {
   "start": 111.56,
   "end": 116.08,
   "text": "अगर दुकानदार सारे सामान को एक ही बड़े बोरे में मिला कर रख देता तो क्या होता?"
  },
  {
   "start": 116.88,
   "end": 119.32,
   "text": "सामान ढूँढने में ही पूरा दिन बीत जाता!"
  },
  {
   "start": 119.82,
   "end": 125.18,
   "text": "समान गुणों के आधार पर चीज़ों को समूहों में रखने को वर्गीकरण (classification) कहते हैं।"
  },
  {
   "start": 125.68,
   "end": 129.08,
   "text": "जैसे रसोई में माँ बर्तन अलग और डिब्बे अलग रखती हैं।"
  },
  {
   "start": 129.58,
   "end": 134.38,
   "text": "समान गुणों के आधार पर चीज़ों को अलग-अलग समूहों में रखने की प्रक्रिया को क्या कहते हैं?"
  },
  {
   "start": 135.38,
   "end": 136.46,
   "text": "सोचिए..."
  },
  {
   "start": 142.46,
   "end": 147.34,
   "text": "उत्तर है — समान गुणों के आधार पर चीज़ों को समूहों में रखना वर्गीकरण कहलाता है।"
  },
  {
   "start": 147.84,
   "end": 152.4,
   "text": "आज हमने सीखा कि हमारे आस-पास की वस्तुएँ अलग-अलग पदार्थों से बनती हैं।"
  },
  {
   "start": 152.9,
   "end": 157.9,
   "text": "किसी चीज़ को बनाने के लिए सही पदार्थ का चुनाव उसके गुणों और काम के हिसाब से किया जाता है।"
  },
  {
   "start": 158.4,
   "end": 163.48,
   "text": "जब हम चीज़ों को उनके गुणों के आधार पर समूहों में बाँटते हैं, तो इसे वर्गीकरण कहते हैं।"
  },
  {
   "start": 163.98,
   "end": 169.02,
   "text": "आज घर की 5 वस्तुएँ चुनकर तालिका बनाइए कि वे किस पदार्थ से बनी हैं और क्यों!"
  }
 ],
