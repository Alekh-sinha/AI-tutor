{
 "id": "lesson-3",
 "title": "पारदर्शिता और पानी में घुलनशीलता",
 "language": "hi-IN",
 "duration": 179.58,
 "audio": "/audio/lesson-3.mp3",
 "narration": [
  {
   "start": 0.0,
   "end": 5.68,
   "text": "आँख-मिचौनी खेलते समय सीमा जब लकड़ी के भारी किवाड़ के पीछे छिपी, तो कोई उसे नहीं देख पाया।"
  },
  {
   "start": 6.18,
   "end": 11.54,
   "text": "फिर वह मोमी कागज़ यानी बटर पेपर के पीछे खड़ी हुई, तो उसकी केवल धुंधली परछाई दिखी।"
  },
  {
   "start": 12.04,
   "end": 17.16,
   "text": "लेकिन जैसे ही सीमा खिड़की के साफ़ काँच के पीछे गई, वह बाहर से बिल्कुल साफ़ दिखने लगी!"
  },
  {
   "start": 17.66,
   "end": 21.66,
   "text": "तीन अलग-अलग चीज़ों के पीछे खड़ी सीमा का दिखना इतना अलग क्यों था?"
  },
  {
   "start": 22.46,
   "end": 28.1,
   "text": "जिन पदार्थों (materials) से आर-पार साफ़ दिखाई देता है, उन्हें हम पारदर्शी (transparent) कहते हैं।"
  },
  {
   "start": 28.6,
   "end": 33.52,
   "text": "जिन पदार्थों से आर-पार बिल्कुल नहीं दिखाई देता, वे अपारदर्शी (opaque) कहलाते हैं।"
  },
  {
   "start": 34.02,
   "end": 38.5,
   "text": "और जिनसे चीज़ें धुंधली दिखाई देती हैं, उन्हें पारभासी (translucent) कहते हैं।"
  },
  {
   "start": 39.0,
   "end": 43.32,
   "text": "अगर किसी कागज़ पर थोड़ा सा तेल लग जाए, तो उस कागज़ को हम क्या कहेंगे?"
  },
  {
   "start": 44.32,
   "end": 45.32,
   "text": "सोचिए..."
  },
  {
   "start": 51.32,
   "end": 57.52,
   "text": "उत्तर है — पारभासी। तेल लगने से कागज़ से रोशनी पूरी तरह नहीं गुज़रती, इसलिए धुंधला दिखता है।"
  },
  {
   "start": 58.02,
   "end": 63.94,
   "text": "शाम को खेल कर आने के बाद जब माँ ने पानी में चीनी और नमक मिलाकर शिकंजी बनाई, तो वे गायब हो गए।"
  },
  {
   "start": 64.44,
   "end": 69.28,
   "text": "लेकिन अगर उसी पानी में हम नदी की रेत या आरी का बुरादा मिला दें, तो क्या होगा?"
  },
  {
   "start": 70.08,
   "end": 73.96,
   "text": "आरी से निकला लकड़ी का बुरादा भी पानी के ऊपर ही तैरता रहता है।"
  },
  {
   "start": 74.46,
   "end": 78.46,
   "text": "क्या रेत और बुरादा भी चीनी की तरह पानी में पूरी तरह गायब हो जाएँगे?"
  },
  {
   "start": 79.26,
   "end": 84.54,
   "text": "जो पदार्थ पानी में पूरी तरह घुल जाते हैं और गायब हो जाते हैं, उन्हें विलेय (soluble) कहते हैं।"
  },
  {
   "start": 85.04,
   "end": 90.84,
   "text": "जो पदार्थ देर तक चम्मच चलाने पर भी पानी में नहीं घुलते, उन्हें अविलेय (insoluble) कहते हैं।"
  },
  {
   "start": 91.34,
   "end": 95.9,
   "text": "पानी में घुले हुए नमक के कण दिखाई नहीं देते, तो नमक पानी के लिए क्या है?"
  },
  {
   "start": 96.9,
   "end": 97.98,
   "text": "सोचिए..."
  },
  {
   "start": 103.98,
   "end": 109.7,
   "text": "उत्तर है — विलेय। नमक पानी में पूरी तरह घुल जाता है, इसलिए वह विलेय पदार्थ है।"
  },
  {
   "start": 110.2,
   "end": 114.92,
   "text": "सोचिए, तालाब के अंदर मछलियाँ बिना बाहर आए पानी में सांस कैसे ले पाती हैं?"
  },
  {
   "start": 115.72,
   "end": 122.56,
   "text": "जैसे हम हवा से ऑक्सीजन लेते हैं, वैसे ही पानी में ऑक्सीजन गैस घुली होती है, जिससे जलचर जीवित रहते हैं।"
  },
  {
   "start": 123.06,
   "end": 128.1,
   "text": "केवल गैस ही नहीं, सिरका जैसी कुछ तरल चीज़ें (liquids) भी पानी में पूरी तरह घुल जाती हैं।"
  },
  {
   "start": 128.6,
   "end": 134.0,
   "text": "लेकिन अगर हम पानी में सरसों का तेल डालें, तो वह ऊपर अलग परत बना लेता है और नहीं घुलता।"
  },
  {
   "start": 134.5,
   "end": 139.58,
   "text": "इस प्रकार ठोस के साथ-साथ द्रव और गैसें भी पानी में विलेय या अविलेय हो सकती हैं।"
  },
  {
   "start": 140.08,
   "end": 143.92,
   "text": "अगर हम पानी में दो चम्मच सरसों का तेल डालकर मिलाएँ, तो क्या होगा?"
  },
  {
   "start": 144.92,
   "end": 146.4,
   "text": "सोचिए..."
  },
  {
   "start": 152.4,
   "end": 158.52,
   "text": "उत्तर है — अलग परत बना कर तैरेगा। सरसों का तेल पानी में अविलेय (insoluble) द्रव है।"
  },
  {
   "start": 159.02,
   "end": 166.26,
   "text": "आज हमने सीखा कि जिनसे आर-पार साफ़ दिखे वे पारदर्शी, धुंधला दिखे वे पारभासी, और न दिखे वे अपारदर्शी हैं।"
  },
  {
   "start": 166.76,
   "end": 172.32,
   "text": "पानी में जो पदार्थ घुल जाते हैं वे विलेय कहलाते हैं, और जो नहीं घुलते वे अविलेय होते हैं।"
  },
  {
   "start": 172.82,
   "end": 178.58,
   "text": "आज घर पर हल्दी, चीनी, चाय पत्ती और तेल को पानी में मिलाकर देखिए कि कौन विलेय है और कौन अविलेय!"
  }
 ],
