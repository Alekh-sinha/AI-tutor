{
 "id": "lesson-2-v2",
 "title": "चमक और कठोरता - पदार्थ के गुण",
 "language": "hi-IN",
 "duration": 320.04,
 "audio": "/audio/lesson-2-v2.mp3",
 "narration": [
  {
   "start": 0.0,
   "end": 8.72,
   "text": "नमस्ते बच्चो! क्या आपने कभी सोचा है कि रसोई का नया बर्तन धूप में कितना चमकता है, जबकि लकड़ी या पुराना कागज़ नहीं चमकते?"
  },
  {
   "start": 9.52,
   "end": 14.72,
   "text": "और जब हम स्पंज को दबाते हैं तो वह आसानी से पिचक जाता है, लेकिन लोहे की कील नहीं दबती!"
  },
  {
   "start": 15.22,
   "end": 20.42,
   "text": "आज के पाठ में हम पदार्थों के इन्हीं गुणों के बारे में सीखेंगे—चमक यानी द्युति और कठोरता।"
  },
  {
   "start": 20.92,
   "end": 28.36,
   "text": "जिन पदार्थों की सतह पर प्राकृतिक रूप से एक खास चमक होती है, उन्हें द्युतिमय या चमकदार पदार्थ कहते हैं।"
  },
  {
   "start": 28.86,
   "end": 33.74,
   "text": "और जिन पदार्थों में यह चमक नहीं होती, उन्हें द्युतिहीन या निष्प्रभ पदार्थ कहते हैं।"
  },
  {
   "start": 34.24,
   "end": 40.48,
   "text": "तांबे की छड़ का ताज़ा काटा सिरा चमकदार चमक रहा है, जबकि लकड़ी की सतह पर कोई चमक नहीं है।"
  },
  {
   "start": 40.98,
   "end": 49.26,
   "text": "लोहा, तांबा, जस्ता, एल्युमिनियम और सोना जैसी धातुएँ चमकदार होती हैं। दूसरी ओर कागज़, लकड़ी, रबड़ और जूट द्युतिहीन होते हैं।"
  },
  {
   "start": 49.76,
   "end": 54.48,
   "text": "पुराने लोहे की कील हवा और नमी के संपर्क में रहने के कारण धुंधली दिखती है।"
  },
  {
   "start": 54.98,
   "end": 60.38,
   "text": "लेकिन जब उसे थोड़ा घिसा या ताज़ा काटा गया, तो अंदर की चमकदार धातु फिर से दिखाई देने लगी।"
  },
  {
   "start": 60.88,
   "end": 67.6,
   "text": "इसलिए किसी धातु की असली चमक देखने के लिए हम उसकी ताज़ी कटी हुई या रेगमाल से घिसी हुई सतह को देखते हैं।"
  },
  {
   "start": 68.1,
   "end": 77.3,
   "text": "यह बात ध्यान रखें, अगर पुराना बर्तन चमक नहीं रहा है, तो भी वह धातु हो सकता है, क्योंकि हवा और नमी से उसकी ऊपरी सतह धुंधली पड़ जाती है।"
  },
  {
   "start": 77.8,
   "end": 83.16,
   "text": "बढ़ई के पास तीन वस्तुएँ हैं—लोहे की पुरानी छड़, लकड़ी का गुटका और जूट की रस्सी।"
  },
  {
   "start": 83.66,
   "end": 90.74,
   "text": "तीनों को बीच से काटने पर किसकी कटी सतह पर चमक दिखाई देगी? लकड़ी का गुटका, जूट की रस्सी, या लोहे की पुरानी छड़?"
  },
  {
   "start": 91.74,
   "end": 93.66,
   "text": "सोचिए और सही उत्तर चुनिए..."
  },
  {
   "start": 99.66,
   "end": 108.22,
   "text": "उत्तर है — लोहे की पुरानी छड़। लोहा एक धातु है, इसलिए बाहरी सतह धुंधली होने पर भी ताज़ा काटने पर प्राकृतिक चमक दिखाई देगी।"
  },
  {
   "start": 108.72,
   "end": 113.48,
   "text": "अब आइए अधातुओं के बारे में जाने। क्या हर चमकने वाली चीज़ धातु होती है?"
  },
  {
   "start": 114.28,
   "end": 121.44,
   "text": "लकड़ी पर वार्निश या मोम की परत लगाने से वह चमकने लगती है। ध्यान रखिए, हर चमकने वाली चीज़ धातु नहीं होती।"
  },
  {
   "start": 121.94,
   "end": 128.66,
   "text": "अधातु पदार्थों जैसे लकड़ी, कागज़ या प्लास्टिक पर पॉलिश, मोम या प्लास्टिक की परत चढ़ाकर बाहर से चमक पैदा की जा सकती है।"
  },
  {
   "start": 129.16,
   "end": 131.08,
   "text": "इसे कृत्रिम चमक कहते हैं।"
  },
  {
   "start": 131.58,
   "end": 135.94,
   "text": "धातु की चमक प्राकृतिक होती है, जबकि अधातु की चमक कृत्रिम होती है।"
  },
  {
   "start": 136.44,
   "end": 141.24,
   "text": "कई बार हम सोचते हैं कि जो भी वस्तु चमकती है वह हमेशा धातु की बनी होती है।"
  },
  {
   "start": 141.74,
   "end": 145.94,
   "text": "लेकिन लकड़ी या कागज़ की वस्तुएँ भी पॉलिश के कारण चमक सकती हैं।"
  },
  {
   "start": 146.44,
   "end": 153.72,
   "text": "सीमा ने बाज़ार से एक चमकीला कागज़ का कप और पॉलिश की हुई लकड़ी की मथानी खरीदी। क्या ये वस्तुएँ धातु की बनी हैं?"
  },
  {
   "start": 154.52,
   "end": 161.92,
   "text": "पहला, हाँ क्योंकि जो चमकता है वह धातु है। दूसरा, नहीं क्योंकि इन पर मोम या पॉलिश से कृत्रिम चमक बनाई गई है।"
  },
  {
   "start": 162.42,
   "end": 165.22,
   "text": "तीसरा, हाँ क्योंकि इनमें प्राकृतिक चमक होती है।"
  },
  {
   "start": 166.22,
   "end": 167.18,
   "text": "सोचिए..."
  },
  {
   "start": 173.18,
   "end": 180.22,
   "text": "उत्तर है — नहीं, क्योंकि इन पर मोम या पॉलिश की परत चढ़ाकर कृत्रिम चमक बनाई गई है। कागज़ और लकड़ी अधातु हैं।"
  },
  {
   "start": 180.72,
   "end": 185.24,
   "text": "अब हम पदार्थों के दूसरे गुण के बारे में सीखेंगे—कठोरता और कोमलता।"
  },
  {
   "start": 185.74,
   "end": 192.1,
   "text": "पदार्थों की कठोरता जाँचने के दो आसान तरीके हैं: पहला संपीडन यानी हाथ से दबाना, और दूसरा खरोंचना।"
  },
  {
   "start": 192.6,
   "end": 195.68,
   "text": "खरोंचना (Scratching): खरोंचकर देखना।"
  },
  {
   "start": 196.18,
   "end": 199.62,
   "text": "जब स्पंज को दबाया जाता है, तो वह आसानी से दब जाता है।"
  },
  {
   "start": 200.12,
   "end": 205.2,
   "text": "जिन पदार्थों को आसानी से दबाया या खरोंचा जा सके, उन्हें कोमल पदार्थ कहते हैं।"
  },
  {
   "start": 205.7,
   "end": 209.54,
   "text": "और जिन्हें दबाना या खरोंचना कठिन हो, उन्हें कठोर पदार्थ कहते हैं।"
  },
  {
   "start": 210.04,
   "end": 214.92,
   "text": "जब लोहे की चाबी से साबुन पर रेखा खींची जाती है, तो आसानी से खरोंच बन जाती है।"
  },
  {
   "start": 215.42,
   "end": 218.42,
   "text": "इसका मतलब साबुन, चाबी की तुलना में कोमल है।"
  },
  {
   "start": 218.92,
   "end": 222.64,
   "text": "कठोरता एक तुलनात्मक या सापेक्ष गुण है। आइए इसे समझें।"
  },
  {
   "start": 223.14,
   "end": 232.54,
   "text": "इरेज़र स्पंज से कठोर है क्योंकि वह आसानी से नहीं पिचकता, लेकिन वही इरेज़र लोहे की चाबी की तुलना में कोमल है क्योंकि चाबी से उसे खरोंचा जा सकता है।"
  },
  {
   "start": 233.04,
   "end": 239.6,
   "text": "याद रखें, कोई वस्तु पूरी तरह कठोर या कोमल नहीं होती; कठोरता हमेशा दूसरी वस्तुओं की तुलना में देखी जाती है।"
  },
  {
   "start": 240.1,
   "end": 246.78,
   "text": "आपके पास तीन चीज़ें हैं—एक स्पंज, एक रबड़ की इरेज़र और एक लोहे की कील। इनमें से कौन-सा कथन सही है?"
  },
  {
   "start": 247.58,
   "end": 255.06,
   "text": "पहला, रबड़ स्पंज से कोमल है लेकिन लोहे से कठोर है। दूसरा, रबड़ स्पंज से कठोर है लेकिन लोहे से कोमल है।"
  },
  {
   "start": 255.56,
   "end": 257.88,
   "text": "तीसरा, तीनों की कठोरता बराबर है।"
  },
  {
   "start": 258.88,
   "end": 259.96,
   "text": "सोचिए..."
  },
  {
   "start": 265.96,
   "end": 269.64,
   "text": "उत्तर है — रबड़, स्पंज से कठोर है लेकिन लोहे से कोमल है।"
  },
  {
   "start": 270.14,
   "end": 275.1,
   "text": "स्पंज आसानी से दबता है, और चाबी की तुलना में रबड़ आसानी से खरोंचा जा सकता है।"
  },
  {
   "start": 275.6,
   "end": 278.68,
   "text": "आइए आज जो सीखा उसका संक्षेप में दोहराव कर लें।"
  },
  {
   "start": 279.18,
   "end": 286.18,
   "text": "पहला, धातुओं में प्राकृतिक चमक होती है। हवा और नमी से धुंधली हुई चमक ताज़ा काटने या घिसने पर वापस दिखती है।"
  },
  {
   "start": 286.68,
   "end": 292.0,
   "text": "दूसरा, अधातुओं जैसे लकड़ी या कागज़ पर पॉलिश या कोटिंग करके कृत्रिम चमक लाई जा सकती है।"
  },
  {
   "start": 292.5,
   "end": 294.38,
   "text": "आज हमने क्या-क्या सीखा?"
  },
  {
   "start": 295.18,
   "end": 300.26,
   "text": "द्युतिमय पदार्थ: धातुओं (लोहा, तांबा, एल्युमिनियम) में प्राकृतिक चमक होती है।"
  },
  {
   "start": 300.76,
   "end": 306.88,
   "text": "हवा और नमी से धातु की चमक धुंधली हो जाती है, जो ताज़ा काटने या घिसने पर वापस दिखती है।"
  },
  {
   "start": 307.38,
   "end": 315.34,
   "text": "तीसरा, जिन्हें दबाना या खरोंचना आसान हो वे कोमल हैं, और जिन्हें कठिन हो वे कठोर हैं। कठोरता एक तुलनात्मक गुण है।"
  },
  {
   "start": 315.84,
   "end": 319.04,
   "text": "अब आपके लिए घर पर करने के लिए एक मज़ेदार गतिविधि है!"
  }
 ],
